@startuml
'https://plantuml.com/class-diagram
skinparam classAttributeIconSize 0

Main ..> printerFacade


class Main {
    menu()
    menuChoice(int max)
    stringInput()
    numberInput()
    numberInput(int min, int max)
}

class printerFacade {
    PrinterManager printerManager;
    PrinterManager printManager;
    PrintTaskManager printTaskManager;
    SpoolManager spoolManager;

    startPrintQueue()
    changePrintStrategy()
    addNewPrintTask()
    showPrints()
    showSpools()
    showPrinters()
    showPendingPrintTasks()

}

package managers {
printerFacade *-- PrinterManager
printerFacade *-- PrintManager
printerFacade *-- PrintTaskManager
printerFacade *-- SpoolManager
    class PrinterManager {
        addPrinter()
        getPrinters()
        registerPrinterFailure(int printerId)
        registerCompletion(int printerId)
        printError(String s)
        readPrintersFromFile(String filename)
    }

    class PrintManager {
        addPrint()
        getPrints()
        findPrint(String printName)
        findPrint(int index)
        readPrintsFromFile(String filename)
    }

    class PrintTaskManager {
        selectPrintTask()
        startInitialQueue()
        getPrinterCurrentTask()
        getPendingPrintTasks()
        addPrintTask()
        printError(String s)
    }

    class SpoolManager {
        containsSpool()
        addSpool(Spool spool)
        getSpools()
        getSpoolByID(int id)
        readSpoolsFromFile(String filename)
    }
}


@enduml