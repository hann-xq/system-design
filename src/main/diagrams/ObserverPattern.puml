@startuml
title Observer Pattern for Printer Manager and Dashboard

interface Subject {
    + addObserver(Observer o)
    + removeObserver(Observer o)
    + notifyObservers()
}

interface Observer {
    + update(spoolStatus: String, completedTasks: int)
}

class PrinterManager implements Subject {
    - observers: List<Observer>
    - spoolStatus: String
    - completedTasks: int
    + addObserver(Observer o)
    + removeObserver(Observer o)
    + notifyObservers()
    + setSpoolStatus(String status)
    + taskCompleted()
}

class Dashboard implements Observer {
    + update(spoolStatus: String, completedTasks: int)
    + displaySpoolStatus()
    + displayCompletedTasks()
}

PrinterManager --> Observer : notifies
@enduml
