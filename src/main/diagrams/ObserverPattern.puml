@startuml
'https://plantuml.com/class-diagram
skinparam {
}

TaskManager o-- DashboardObserver
Main *-- PrintFacade
PrintFacade *-- TaskManager

interface DashboardObserver {
    void updateSpoolChanges(int spoolChanges);
    void updatePrintsFulfilled(int printsFulfilled);
}

class TaskManager {
    - List<DashboardObserver> observers;
    - int spoolChanges;
    - int printsFulfilled;
    + void addObserver(DashboardObserver observer)
    + void removeObserver(DashboardObserver observer) {
    - void notifySpoolChanges()
    - void notifyPrintsFulfilled()
    - void incrementSpoolChanges()
    - void incrementPrintsFulfilled()
}

class PrintFacade {
    + void addObserver(DashboardObserver observer)
    + void removeObserver(DashboardObserver observer)
}

class Main implements DashboardObserver {
    void updateSpoolChanges(int spoolChanges);
    void updatePrintsFulfilled(int printsFulfilled);
}

PrinterManager --> Observer : notifies
@enduml