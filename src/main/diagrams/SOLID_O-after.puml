@startuml
'https://plantuml.com/class-diagram
'skinparam classAttributeIconSize 0

Printer *-- PrintSize
Printer *-- PrinterDescription

abstract class Printer {
    - PrinterDescription printerDescription
    - PrintSize printSize
    - boolean isHoused

    + Printer(PrinterDescription printerDescription, PrintSize printSize, boolean isHoused)
    + int getId()
    + String getName()
    + boolean printFits(Print print)
    + boolean filamentAndMaxColorsMatches(PrintTask printTask)
    + boolean spoolsMatchForPrintTask(PrintTask printTask)
    + void reduceSpoolsByLength(List<Double> filamentLength)

}

class PrintSize {
    - int maxX
    - int maxY
    - int maxZ
    + PrintSize(int maxX, int maxY, int maxZ)
    + int getMaxX()
    + int getMaxY()
    + int getMaxZ()
}

class PrinterDescription {
    - int id
    - String name
    - String manufacturer
    + PrinterDescription (int id, String printerName, String manufacturer)
    + int getId()
    + String getName()
    + String getManufacturer()
}

class SingleSpoolPrinter extends Printer {
    - Spool currentSpool;
    + SingleSpooledPrinter(PrinterDescription printerDescription, PrintSize printSize, boolean isHoused)
    + getCurrentSpool()
    + setCurrentSpool(Spool spool)
}

class MultiSpoolPrinter extends Printer {
    - List<Spool> spools;
    + MultiSpooledPrinter(PrinterDescription printerDescription, PrintSize printSize, boolean isHoused)
    + List<Spool> getCurrentSpools()
    + void setCurrentSpools(List<Spool> spools)
}

class MultiColorPrinter extends MultiSpoolPrinter {
    - int maxColors;
    + getMaxColors()
}


@enduml