@startuml
'https://plantuml.com/class-diagram

PrinterFactory -- Printer
PrinterFactory ..> PrintSize
PrinterFactory ..> PrinterDescription

class PrinterFactory {
  + createPrinter(int type, PrinterDescription printerDescription, PrintSize printSize): Printer
}

Printer *-- PrintSize
Printer *-- PrinterDescription

abstract class Printer {
    - PrinterDescription printerDescription
    - PrintSize printSize
    - Spool currentSpool
    boolean isHoused

    + Printer(PrinterDescription printerDescription, PrintSize printSize, boolean isHoused)
    + int getId()
    + String getName()
    + printFits(Print print)
    + getName()
}

class PrintSize {
    - int maxX
    - int maxY
    - int maxZ
    + PrintSize(int maxX, int maxY, int maxZ)
}

class PrinterDescription {
    - int id
    - String name
    - String manufacturer
    + PrinterDescription (int id, String printerName, String manufacturer)
}

class SingleSpoolPrinter extends Printer {
    +getCurrentSpool()
    +setCurrentSpool(Spool spool)
}

class MultiSpoolPrinter extends Printer {
    +Spool[] spools
    +getCurrentSpools()
    +setCurrentSpools(ArrayList<Spool> spools)
}

class MultiColor extends MultiSpoolPrinter {
    -int maxColors;
    +getMaxColors()
}


@enduml