@startuml
skinparam class {

    ArrowColor Black
    BorderColor Black
}

title Strategy Pattern for PrinterManager

interface PrintTaskSelectorStrategy{
    +selectTask(): Task
}

class StandardFDMTaskSelector  {
    +selectTask(): Task
}
class HousedPrinterTaskSelector {
    +selectTask(): Task
}
class MultiColorTaskSelector  {
    +selectTask(): Task
}

class PrinterManager {
    -taskSelector: PrintTaskSelector
    +setTaskSelector(selector: PrintTaskSelector): void
    +selectTask(): Task
}

PrintTaskSelectorStrategy <|-- StandardFDMTaskSelector : implements
PrintTaskSelectorStrategy <|-- HousedPrinterTaskSelector : implements
PrintTaskSelectorStrategy <|-- MultiColorTaskSelector : implements

PrinterManager o-- PrintTaskSelectorStrategy : uses
@enduml
