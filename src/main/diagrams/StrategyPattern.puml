@startuml
skinparam class {

}

interface SelectPrintTaskStrategy <<strategy>> {
    void selectPrintTask(Printer printer)
    String getStrategyName()
}

class LessSpoolChangeStrategy implements SelectPrintTaskStrategy {
    - TaskManager taskManager
    + LessSpoolChangeStrategy(TaskManager taskManager)
}
class EfficientSpoolUsageStrategy implements SelectPrintTaskStrategy {
    - SpoolManager spoolManager;
    - TaskManager taskManager;
    + EfficientSpoolUsageStrategy(TaskManager taskManager, SpoolManager spoolManager)
}

class TaskManager {
    - SelectPrintTaskStrategy strategy;
    + void selectPrintStrategy(SelectPrintTaskStrategy strategy)
    + String getStrategy()
}

TaskManager *-- SelectPrintTaskStrategy
@enduml
