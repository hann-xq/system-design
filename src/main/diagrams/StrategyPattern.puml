@startuml
skinparam class {

    ArrowColor Black
    BorderColor Black
}

title Strategy Pattern for PrinterManager

interface PrintTaskSelector <<strategy>> {
    +selectTask(): Task
}

class StandardFDMTaskSelector  {
    +selectTask(): Task
}
class HousedPrinterTaskSelector {
    +selectTask(): Task
}
class MultiColorTaskSelector  {
    +selectTask(): Task
}

class PrinterManager {
    -taskSelector: PrintTaskSelector
    +setTaskSelector(selector: PrintTaskSelector): void
    +selectTask(): Task
}

PrintTaskSelector <|-- StandardFDMTaskSelector : implements
PrintTaskSelector <|-- HousedPrinterTaskSelector : implements
PrintTaskSelector <|-- MultiColorTaskSelector : implements

PrinterManager o-- PrintTaskSelector : uses
@enduml
